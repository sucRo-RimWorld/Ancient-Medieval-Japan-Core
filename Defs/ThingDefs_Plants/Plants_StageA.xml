<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Stage A millets share the same harvested ThingDef and post-harvest chain.
    Awa, Hie, and Kibi use crop-specific mature and immature plant textures;
    their harvested states intentionally converge on the shared millet chain.
  -->
  <ThingDef ParentName="PlantBase">
    <defName>AMJC_Plant_FoxtailMillet_Awa</defName>
    <label>foxtail millet plant</label>
    <description>Foxtail millet (awa), a traditional dryland millet used as a staple grain. It takes longer to mature than kibi but produces more grain per harvest, making it well suited to ordinary main fields.</description>
    <descriptionHyperlinks>
      <ThingDef>AMJC_RawMillet</ThingDef>
    </descriptionHyperlinks>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Nutrition>0.2</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plants/FullGrown/AMJC_Awa</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>10</pathCost>
    <ingestible />
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0.4</fertilitySensitivity>
      <dieIfLeafless>true</dieIfLeafless>
      <harvestTag>Standard</harvestTag>
      <maxMeshCount>4</maxMeshCount>
      <harvestedThingDef>AMJC_RawMillet</harvestedThingDef>
      <harvestYield>13</harvestYield>
      <sowTags><li>Ground</li></sowTags>
      <topWindExposure>0.20</topWindExposure>
      <growDays>6</growDays>
      <minGrowthTemperature>8</minGrowthTemperature>
      <maxGrowthTemperature>42</maxGrowthTemperature>
      <minOptimalGrowthTemperature>18</minOptimalGrowthTemperature>
      <maxOptimalGrowthTemperature>32</maxOptimalGrowthTemperature>
      <visualSizeRange>0.5~1.0</visualSizeRange>
      <immatureGraphicPath>Things/Plants/Immature/AMJC_Awa</immatureGraphicPath>
      <wildOrder>2</wildOrder>
      <purpose>Food</purpose>
      <sowMinSkill>0</sowMinSkill>
    </plant>
  </ThingDef>

  <ThingDef ParentName="PlantBase">
    <defName>AMJC_Plant_BarnyardMillet_Hie</defName>
    <label>Japanese barnyard millet plant</label>
    <description>Japanese barnyard millet (hie), a traditional grain crop suited to cool growing conditions. It can keep growing at lower temperatures than awa or kibi, but it is not especially frost hardy.</description>
    <descriptionHyperlinks>
      <ThingDef>AMJC_RawMillet</ThingDef>
    </descriptionHyperlinks>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Nutrition>0.2</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plants/FullGrown/AMJC_Hie</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>10</pathCost>
    <ingestible />
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0.5</fertilitySensitivity>
      <dieIfLeafless>true</dieIfLeafless>
      <harvestTag>Standard</harvestTag>
      <maxMeshCount>4</maxMeshCount>
      <harvestedThingDef>AMJC_RawMillet</harvestedThingDef>
      <harvestYield>12</harvestYield>
      <sowTags><li>Ground</li></sowTags>
      <topWindExposure>0.20</topWindExposure>
      <growDays>6</growDays>
      <minGrowthTemperature>5</minGrowthTemperature>
      <maxGrowthTemperature>40</maxGrowthTemperature>
      <minOptimalGrowthTemperature>15</minOptimalGrowthTemperature>
      <maxOptimalGrowthTemperature>30</maxOptimalGrowthTemperature>
      <visualSizeRange>0.5~1.0</visualSizeRange>
      <immatureGraphicPath>Things/Plants/Immature/AMJC_Hie</immatureGraphicPath>
      <wildOrder>3</wildOrder>
      <purpose>Food</purpose>
      <sowMinSkill>0</sowMinSkill>
    </plant>
  </ThingDef>

  <ThingDef ParentName="PlantBase">
    <defName>AMJC_Plant_ProsoMillet_Kibi</defName>
    <label>proso millet plant</label>
    <description>Proso millet (kibi), a fast-growing traditional millet suited to short growing seasons and poorer soils. It matures faster than awa or hie but produces less grain per harvest.</description>
    <descriptionHyperlinks>
      <ThingDef>AMJC_RawMillet</ThingDef>
    </descriptionHyperlinks>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Nutrition>0.2</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plants/FullGrown/AMJC_Kibi</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>10</pathCost>
    <ingestible />
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0.3</fertilitySensitivity>
      <dieIfLeafless>true</dieIfLeafless>
      <harvestTag>Standard</harvestTag>
      <maxMeshCount>4</maxMeshCount>
      <harvestedThingDef>AMJC_RawMillet</harvestedThingDef>
      <harvestYield>11</harvestYield>
      <sowTags><li>Ground</li></sowTags>
      <topWindExposure>0.20</topWindExposure>
      <growDays>5</growDays>
      <minGrowthTemperature>8</minGrowthTemperature>
      <maxGrowthTemperature>42</maxGrowthTemperature>
      <minOptimalGrowthTemperature>18</minOptimalGrowthTemperature>
      <maxOptimalGrowthTemperature>32</maxOptimalGrowthTemperature>
      <visualSizeRange>0.5~1.0</visualSizeRange>
      <immatureGraphicPath>Things/Plants/Immature/AMJC_Kibi</immatureGraphicPath>
      <wildOrder>4</wildOrder>
      <purpose>Food</purpose>
      <sowMinSkill>0</sowMinSkill>
    </plant>
  </ThingDef>


  <ThingDef ParentName="PlantBase">
    <defName>AMJC_Plant_Buckwheat_Soba</defName>
    <label>buckwheat plant</label>
    <description>Buckwheat (soba), a very fast-growing grain crop suited to poor soils and short growing seasons. It performs well where richer-soil cereals are inefficient, but it is relatively vulnerable to frost.</description>
    <descriptionHyperlinks>
      <ThingDef>AMJC_RawBuckwheat</ThingDef>
    </descriptionHyperlinks>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Nutrition>0.2</Nutrition>
    </statBases>
    <graphicData>
      <!-- TEMP: reuse accepted Awa plant art until the Art/graphics workstream supplies Soba-specific textures. -->
      <texPath>Things/Plants/FullGrown/AMJC_Awa</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>10</pathCost>
    <ingestible />
    <plant>
      <fertilityMin>0.4</fertilityMin>
      <fertilitySensitivity>0.25</fertilitySensitivity>
      <dieIfLeafless>true</dieIfLeafless>
      <harvestTag>Standard</harvestTag>
      <maxMeshCount>4</maxMeshCount>
      <harvestedThingDef>AMJC_RawBuckwheat</harvestedThingDef>
      <harvestYield>8</harvestYield>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <topWindExposure>0.20</topWindExposure>
      <growDays>4</growDays>
      <minGrowthTemperature>5</minGrowthTemperature>
      <maxGrowthTemperature>35</maxGrowthTemperature>
      <minOptimalGrowthTemperature>12</minOptimalGrowthTemperature>
      <maxOptimalGrowthTemperature>25</maxOptimalGrowthTemperature>
      <visualSizeRange>0.5~1.0</visualSizeRange>
      <immatureGraphicPath>Things/Plants/Immature/AMJC_Awa</immatureGraphicPath>
      <wildOrder>5</wildOrder>
      <purpose>Food</purpose>
      <sowMinSkill>1</sowMinSkill>
    </plant>
  </ThingDef>


  <ThingDef ParentName="PlantBase">
    <defName>AMJC_Plant_Barley</defName>
    <label>barley plant</label>
    <description>Barley, a cool-season cereal crop suited to relatively poor soils and cold growing conditions. It takes longer to mature than the Stage A millets but yields a larger harvest and is useful as a staple grain.</description>
    <descriptionHyperlinks>
      <ThingDef>AMJC_RawBarley</ThingDef>
    </descriptionHyperlinks>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Nutrition>0.2</Nutrition>
    </statBases>
    <graphicData>
      <!-- TEMP: Medieval Overhaul wheat plant art until Art/graphics supplies Barley-specific textures. -->
      <texPath>Things/Plants/FullGrown/WheatPlant</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>10</pathCost>
    <ingestible />
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0.6</fertilitySensitivity>
      <dieIfLeafless>true</dieIfLeafless>
      <harvestTag>Standard</harvestTag>
      <maxMeshCount>4</maxMeshCount>
      <harvestedThingDef>AMJC_RawBarley</harvestedThingDef>
      <harvestYield>22</harvestYield>
      <sowResearchPrerequisites>
        <li>DankPyon_BasicAgriculture</li>
      </sowResearchPrerequisites>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <topWindExposure>0.20</topWindExposure>
      <growDays>10</growDays>
      <minGrowthTemperature>0</minGrowthTemperature>
      <maxGrowthTemperature>35</maxGrowthTemperature>
      <minOptimalGrowthTemperature>5</minOptimalGrowthTemperature>
      <maxOptimalGrowthTemperature>22</maxOptimalGrowthTemperature>
      <visualSizeRange>0.5~1.0</visualSizeRange>
      <immatureGraphicPath>Things/Plants/Immature/WheatPlant</immatureGraphicPath>
      <wildOrder>6</wildOrder>
      <purpose>Food</purpose>
      <sowMinSkill>2</sowMinSkill>
    </plant>
  </ThingDef>

</Defs>
