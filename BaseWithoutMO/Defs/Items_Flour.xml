<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="RoughPlantBase">
    <defName>AMJC_WheatFlour</defName>
    <label>wheat flour</label>
    <description>Wheat flour (komugiko). Flour ground from wheat grains using a stone mill. In AMJGrains, it is used to prepare hakutaku.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Millet/Millet</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <Nutrition>0.05</Nutrition>
      <MarketValue>1.5</MarketValue>
    </statBases>
    <stackLimit>75</stackLimit>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
      <foodType>VegetableOrFruit</foodType>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>60</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>Foods</li>
    </thingCategories>
  </ThingDef>
</Defs>
