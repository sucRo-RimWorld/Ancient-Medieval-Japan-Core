<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Shared millet states for Awa/Hie/Kibi.
    These are deliberately excluded from DankPyon_Cereal so MO's generic
    flour/ale routes cannot bypass AMJ's threshing and hulling steps.
  -->
  <ThingDef ParentName="RoughPlantBase">
    <defName>AMJC_RawMillet</defName>
    <label>millet sheaf</label>
    <description>Harvested millet stalks and seed heads bundled together before threshing and hulling. They keep well in storage but are not yet suitable for eating.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Millet/MixedMilletSheafDense</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.1</MarketValue>
    </statBases>
    <ingestible>
      <foodType>Seed</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>120</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>Foods</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="RoughPlantBase">
    <defName>AMJC_MilletInHull</defName>
    <label>millet in hull</label>
    <description>Millet grain after threshing but before the hulls have been removed. The hull protects the grain during storage, but it is not yet suitable for eating.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Millet/MilletInHull</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.1</MarketValue>
    </statBases>
    <ingestible>
      <foodType>Seed</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>120</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>Foods</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="PlantFoodRawBase">
    <defName>AMJC_Millet</defName>
    <label>millet</label>
    <description>Edible millet grain with its hull removed. A basic staple that can be eaten as grain or used as an ingredient in ordinary meals.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Millet/Millet</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.2</MarketValue>
      <Nutrition>0.05</Nutrition>
    </statBases>
    <ingestible>
      <tasteThought>AteRawFood</tasteThought>
      <foodType>VegetableOrFruit</foodType>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>90</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>


  <!--
    Buckwheat processing states. They intentionally remain outside
    DankPyon_Cereal so MO generic processing cannot bypass AMJ threshing/hulling.
    Soba-specific production art is wired per state as it is approved. Each
    approved state uses its dedicated AMJ-owned texture path.
  -->
  <ThingDef ParentName="RoughPlantBase">
    <defName>AMJC_RawBuckwheat</defName>
    <label>buckwheat sheaf</label>
    <description>Harvested buckwheat stems and seed clusters before threshing. It stores well but is not yet suitable for eating.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Buckwheat/RawBuckwheatDense</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.0</MarketValue>
    </statBases>
    <ingestible>
      <foodType>Seed</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>120</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>Foods</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="RoughPlantBase">
    <defName>AMJC_BuckwheatInHull</defName>
    <label>buckwheat in hull</label>
    <description>Threshed buckwheat grain with its hull still attached. The hull protects it in storage, but it is not yet suitable for eating.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Buckwheat/BuckwheatInHull</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.0</MarketValue>
    </statBases>
    <ingestible>
      <foodType>Seed</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>120</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>Foods</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="PlantFoodRawBase">
    <defName>AMJC_Buckwheat</defName>
    <label>buckwheat</label>
    <description>Edible buckwheat grain with its hull removed. It is a short-lived staple grain suited to direct cooking; flour is introduced only when a concrete flour-based use is implemented.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Buckwheat/Buckwheat</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.2</MarketValue>
      <Nutrition>0.05</Nutrition>
    </statBases>
    <ingestible>
      <tasteThought>AteRawFood</tasteThought>
      <foodType>VegetableOrFruit</foodType>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>60</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>


  <!--
