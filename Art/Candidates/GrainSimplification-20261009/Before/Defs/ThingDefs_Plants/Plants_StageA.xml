  </ThingDef>


  <ThingDef ParentName="PlantBase">
    <defName>AMJC_Plant_Buckwheat_Soba</defName>
    <label>buckwheat plant</label>
    <description>Buckwheat (soba). In ancient Japan it was recommended as a crop to guard against poor harvests, and it has been grown in mountain regions and on less fertile land. In AMJGrains it grows quickly but is vulnerable to frost, and requires threshing and dehulling. Older ways of eating buckwheat are distinct from cut soba noodles, which became widespread in the Edo period.</description>
    <descriptionHyperlinks>
      <ThingDef>AMJC_RawBuckwheat</ThingDef>
    </descriptionHyperlinks>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Nutrition>0.2</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plants/FullGrown/AMJC_Soba</texPath>
