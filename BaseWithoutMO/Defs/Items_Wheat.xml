<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="RoughPlantBase">
    <defName>AMJC_RawWheat</defName>
    <label>wheat sheaf</label>
    <description>Wheat sheaf (komugitaba). Harvested wheat with the heads and stalks still attached. It cannot be eaten before threshing, which produces edible wheat grains.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Wheat/RawWheatDense</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.1</MarketValue>
    </statBases>
    <ingestible>
      <foodType>Seed</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>120</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>Foods</li>
    </thingCategories>
  </ThingDef>
</Defs>
