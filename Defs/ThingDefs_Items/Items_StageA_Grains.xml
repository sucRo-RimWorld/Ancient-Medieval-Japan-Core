  <ThingDef ParentName="PlantFoodRawBase">
    <defName>AMJC_Barley</defName>
    <label>barley</label>
    <description>Edible barley grain with its hull removed. A durable staple grain that can be cooked directly and can support additional barley-based processing in later content.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Millet/Millet</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.2</MarketValue>
      <Nutrition>0.05</Nutrition>
    </statBases>
    <ingestible>
      <tasteThought>AteRawFood</tasteThought>
      <foodType>VegetableOrFruit</foodType>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>90</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>


  <!--
    Processed MO wheat grain. DankPyon_RawWheat remains the harvested sheaf;
    this edible state is the only Stage A wheat item placed in DankPyon_Cereal,
    so MO milling/brewing routes cannot bypass threshing.
    TEMP graphic: shared AMJ edible-grain art until Art/graphics supplies wheat grain.
  -->
  <ThingDef ParentName="PlantFoodRawBase">
    <defName>AMJC_Wheat</defName>
    <label>wheat grain</label>
    <description>Edible wheat grain separated from the harvested stalks by threshing. It can be cooked directly or used by Medieval Overhaul cereal-processing recipes such as milling.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Millet/Millet</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.2</MarketValue>
      <Nutrition>0.05</Nutrition>
    </statBases>
    <ingestible>
      <tasteThought>AteRawFood</tasteThought>
      <foodType>VegetableOrFruit</foodType>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>90</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>

  <!-- Temporary shared AMJ textures; final rice art follows runtime checks. -->
  <ThingDef ParentName="RoughPlantBase">
    <defName>AMJC_RiceSheaf</defName>
    <label>rice sheaf</label>
    <description>Harvested rice stalks and ears tied into sheaves. Threshing and hulling are needed before this rice can be eaten.</description>
    <graphicData><texPath>Things/Item/Resource/AMJC_Rice/RiceSheafDense</texPath><graphicClass>Graphic_StackCount</graphicClass></graphicData>
    <statBases><MarketValue>1.1</MarketValue></statBases>
    <ingestible><foodType>Seed</foodType><preferability>NeverForNutrition</preferability></ingestible>
    <comps><li Class="CompProperties_Rottable"><daysToRotStart>120</daysToRotStart><rotDestroys>true</rotDestroys></li></comps>
    <thingCategories><li>Foods</li></thingCategories>
  </ThingDef>
  <ThingDef ParentName="RoughPlantBase">
    <defName>AMJC_RiceInHull</defName>
    <label>rice in hull</label>
    <description>Rice grains after threshing, still enclosed in their husks. Remove the husks to obtain edible Vanilla rice.</description>
    <graphicData><texPath>Things/Item/Resource/AMJC_Millet/MilletInHull</texPath><graphicClass>Graphic_StackCount</graphicClass></graphicData>
    <statBases><MarketValue>1.1</MarketValue></statBases>
    <ingestible><foodType>Seed</foodType><preferability>NeverForNutrition</preferability></ingestible>
    <comps><li Class="CompProperties_Rottable"><daysToRotStart>120</daysToRotStart><rotDestroys>true</rotDestroys></li></comps>
    <thingCategories><li>Foods</li></thingCategories>
  </ThingDef>

</Defs>
