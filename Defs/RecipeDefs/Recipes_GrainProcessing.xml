<Defs>

  <RecipeDef Name="AMJC_MilletProcessingBase" Abstract="True">
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.1</workSkillLearnFactor>
    <allowMixingIngredients>false</allowMixingIngredients>
    <recipeUsers>
      <li>AMJC_GrainProcessingSpot</li>
      <li>AMJC_GrainProcessingTable</li>
    </recipeUsers>
  </RecipeDef>

  <RecipeDef ParentName="AMJC_MilletProcessingBase">
    <defName>AMJC_ThreshMillet</defName>
    <label>thresh millet</label>
    <description>Thresh raw millet to separate the grain from the straw. The grain remains in its protective hull.</description>
    <jobString>Threshing millet.</jobString>
    <workAmount>15</workAmount>
    <targetCountAdjustment>1</targetCountAdjustment>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>AMJC_RawMillet</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>AMJC_RawMillet</li>
      </thingDefs>
      <specialFiltersToDisallow>
        <li>AllowRotten</li>
      </specialFiltersToDisallow>
    </fixedIngredientFilter>
    <products>
      <AMJC_MilletInHull>1</AMJC_MilletInHull>
      <DankPyon_Straw>1</DankPyon_Straw>
    </products>
  </RecipeDef>

