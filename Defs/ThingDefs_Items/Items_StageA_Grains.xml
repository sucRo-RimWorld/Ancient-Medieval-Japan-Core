      <texPath>Things/Item/Resource/AMJC_Barley/RawBarleyDense</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.1</MarketValue>
    </statBases>
    <ingestible>
      <foodType>Seed</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>120</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>Foods</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="RoughPlantBase">
    <defName>AMJC_BarleyInHull</defName>
    <label>barley in hull</label>
    <description>Threshed barley grain with its hull still attached. The hull protects it during storage, but it is not yet suitable for eating.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Barley/BarleyInHull</texPath>
